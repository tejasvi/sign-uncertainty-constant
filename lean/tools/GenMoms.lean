import SUCert.LowCfg

open SignUnc.Chk SignUnc.LowData

def ballS (b : Ival.Ball) : String := s!"⟨{b.m}, {b.r}⟩"
def l1S (l : List Ival.Ball) : String := "[" ++ ", ".intercalate (l.map ballS) ++ "]"

/-- One definition per innermost list (`pfx_i_j`), per piece (`pfx_i`), and the table. -/
def emit (name pfx : String) (M N : Nat) : IO Unit := do
  let moms := lowP.map (pieceMoms 128 M N)
  let mut s := s!"import SUCert.Low\n\n/-! `{name} = lowP.map (pieceMoms 128 {M} {N})`, generated by SignUnc/Test11b/GenMoms.lean (native). -/\n\nset_option maxRecDepth 100000\n\nnamespace SignUnc.LowData\nopen Ival\n\n"
  let mut i := 0
  for a in moms do
    let mut j := 0
    for b in a do
      s := s ++ s!"def {pfx}_{i}_{j} : List Ball := {l1S b}\n"
      j := j + 1
    s := s ++ s!"def {pfx}_{i} : List (List Ball) := [" ++ ", ".intercalate ((List.range a.length).map fun k => s!"{pfx}_{i}_{k}") ++ "]\n\n"
    i := i + 1
  s := s ++ s!"def {name} : List (List (List Ball)) := [" ++ ", ".intercalate ((List.range moms.length).map fun k => s!"{pfx}_{k}") ++ "]\n\nend SignUnc.LowData\n"
  IO.FS.createDirAll "tmp"
  IO.FS.writeFile s!"tmp/{name}.lean" s

#eval emit "MomsLit20" "m20" 20 25
#eval emit "MomsLit16" "m16" 16 135
